// Project model
model Project {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  clientName      String
  hideClientName  Boolean       @default(false)
  shortDescription String       @db.Text
  longDescription  String       @db.Text
  problem         String?       @db.Text
  solution        String?       @db.Text
  images          ProjectImage[]
  technologies    Technology[]
  duration        Int           // in days
  teamSize        Int
  budget          Float?
  metrics         String?       @db.Text
  status          ProjectStatus @default(COMPLETED)
  featured        Boolean       @default(false)
  order           Int           @default(0)
  testimonial     Testimonial?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Images d'un projet
model ProjectImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Technologies
model Technology {
  id        String     @id @default(cuid())
  name      String     @unique
  category  TechCategory
  logo      String?
  projects  Project[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Témoignages clients
model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  clientRole  String
  company     String
  content     String   @db.Text
  photo       String?
  projectId   String?  @unique
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Demandes de contact
model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String
  message   String        @db.Text
  budget    String?
  status    ContactStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// Paramètres du site (statistiques, etc.)
model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Enums
enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  FEATURED
}

enum TechCategory {
  FRONTEND
  BACKEND
  MOBILE
  DATABASE
  DEVOPS
  DESIGN
  OTHER
}

enum ContactStatus {
  UNREAD
  READ
  ARCHIVED
}
